# Copy to .env (never commit it) or export in your shell.
# Needed only for the AI scripts: npm run ai:generate / npm run ai:analyze
ANTHROPIC_API_KEY=
# Optional: override the Claude model (default: claude-opus-5-5)
# CLAUDE_MODEL=claude-opus-5-5
# Optional: base URL for `npm run test:remote`
# BASE_URL=http://localhost:3000
