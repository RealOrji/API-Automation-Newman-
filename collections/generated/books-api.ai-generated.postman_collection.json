{
  "info": {
    "name": "Bookstore API (AI-generated)",
    "description": "Hand-written EXAMPLE plan in the same format Claude returns, so you can try the generator without an API key. It covers the happy path of each operation, auth, boundary validation and error shape.\n\nGenerated by ai/generate-tests.js from api/openapi.yaml (plan file ai/examples/test-plan.example.json). Review before you rely on it.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Fresh 13-digit ISBN for every request, so creates never collide.",
          "pm.variables.set('uniqueIsbn', '979' + String(Math.floor(Math.random() * 1e10)).padStart(10, '0'));"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "bookId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Setup",
      "description": "Fixed preconditions added by the generator (not by the AI).",
      "item": [
        {
          "name": "Reset test data",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Reset returns 204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/test/reset",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
