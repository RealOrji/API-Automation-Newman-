                  "pm.test(\"token is a(n) string\", () => pm.expect(valueAt(pm.response.json(), \"token\")).to.be.an(\"string\"));",
                  "pm.test(\"tokenType equals \\\"Bearer\\\"\", () => pm.expect(valueAt(pm.response.json(), \"tokenType\")).to.eql(\"Bearer\"));"
                ]
              }
            }
          ],
