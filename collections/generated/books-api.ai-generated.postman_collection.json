    {
      "name": "Health",
      "item": [
        {
          "name": "Health endpoint reports ok",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "const valueAt = (obj, p) => (p ? p.split('.').reduce((o, k) => (o == null ? undefined : o[k]), obj) : obj);",
                  "pm.test(\"status equals \\\"ok\\\"\", () => pm.expect(valueAt(pm.response.json(), \"status\")).to.eql(\"ok\"));",
                  "pm.test(\"uptime is a(n) number\", () => pm.expect(valueAt(pm.response.json(), \"uptime\")).to.be.an(\"number\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "If the service is not healthy, every other result is noise.",
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
