                  "pm.test(\"details is a(n) array\", () => pm.expect(valueAt(pm.response.json(), \"details\")).to.be.an(\"array\"));",
                  "pm.test(\"error is present\", () => pm.expect(valueAt(pm.response.json(), \"error\")).to.not.be.undefined);"
                ]
