              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 404', () => pm.response.to.have.status(404));",
                  "pm.test('Error body matches the Error schema', () => {",
                  "    pm.response.to.have.jsonSchema(JSON.parse(pm.collectionVariables.get('schema.error')));",
                  "});",
                  "pm.test('Error details mention \"99999\"', () => {",
                  "    const details = pm.response.json().details.join(' ');",
                  "    pm.expect(details).to.include('99999');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books/99999",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books",
                "99999"
