    {
      "name": "Books - CRUD flow",
      "description": "An end-to-end happy path. Each request uses values saved by the previous one.",
      "item": [
        {
          "name": "Create a book",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// A fresh 13-digit ISBN per run so the create never collides with existing data.",
                  "const isbn = '978' + String(Date.now()).slice(-10);",
                  "pm.collectionVariables.set('newIsbn', isbn);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', () => pm.response.to.have.status(201));",
                  "const book = pm.response.json();",
                  "pm.test('Body matches the Book schema', () => {",
                  "    pm.response.to.have.jsonSchema(JSON.parse(pm.collectionVariables.get('schema.book')));",
                  "});",
                  "pm.test('Saved fields match what was sent', () => {",
                  "    pm.expect(book).to.include({",
                  "        title: 'API Testing with Newman',",
                  "        author: 'Ada Tester',",
                  "        isbn: pm.collectionVariables.get('newIsbn'),",
                  "        price: 19.99,",
                  "        inStock: true,",
                  "    });",
                  "});",
                  "pm.test('Location header points to the new book', () => {",
                  "    pm.expect(pm.response.headers.get('Location')).to.eql('/books/' + book.id);",
                  "});",
                  "pm.collectionVariables.set('bookId', book.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/books",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"API Testing with Newman\",\n  \"author\": \"Ada Tester\",\n  \"isbn\": \"{{newIsbn}}\",\n  \"price\": 19.99\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Get the created book",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Returns the book that was created', () => {",
                  "    const book = pm.response.json();",
                  "    pm.expect(String(book.id)).to.eql(String(pm.collectionVariables.get('bookId')));",
                  "    pm.expect(book.isbn).to.eql(pm.collectionVariables.get('newIsbn'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books/{{bookId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books",
                "{{bookId}}"
              ]
            }
          }
        },
        {
          "name": "Update the price",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Only the sent fields changed', () => {",
                  "    const book = pm.response.json();",
                  "    pm.expect(book.price).to.eql(24.5);",
                  "    pm.expect(book.inStock).to.eql(false);",
                  "    pm.expect(book.title).to.eql('API Testing with Newman');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/books/{{bookId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books",
                "{{bookId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 24.5,\n  \"inStock\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Delete the book",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 204', () => pm.response.to.have.status(204));",
                  "pm.test('Body is empty', () => pm.expect(pm.response.text()).to.be.empty);"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books/{{bookId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books",
                "{{bookId}}"
              ]
            }
          }
        },
        {
          "name": "Get the deleted book returns 404",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 404', () => pm.response.to.have.status(404));",
                  "pm.test('Error body matches the Error schema', () => {",
                  "    pm.response.to.have.jsonSchema(JSON.parse(pm.collectionVariables.get('schema.error')));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books/{{bookId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books",
                "{{bookId}}"
              ]
            }
          }
        }
      ]
    },
